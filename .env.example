# Copy this file to .env.local and change the values.

# Password for the admin pages (/admin)
ADMIN_PASSWORD=change-this-password

# Long random string used to sign the admin login cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-this-to-a-long-random-string

# Optional: where the SQLite file is stored (default: ./data/zhabto.db)
# DB_PATH=/var/lib/zhabto/zhabto.db
